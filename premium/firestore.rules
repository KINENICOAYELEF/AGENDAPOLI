rules_version = '2'; 
service cloud.firestore { 
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Funciones Auxiliares de Seguridad (FASE 11.1 - ROBUSTO)
    // --------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    function isDocente() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "DOCENTE";
    }
    function isInterno() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "INTERNO";
    }
    function isProgramActive(year) {
      // Verifica usando un 'get' al documento de settings de ese año
      return get(/databases/$(database)/documents/programs/$(year)/meta/settings).data.isActive == true;
    }

    // --------------------------------------------------------------------
    // REGLA MAESTRA: DENY-BY-DEFAULT
    // Si la request intenta explorar una colección no expresamente catalogada
    // abajo (ej: un nodo legacy o un nodo global), será rechazada.
    // --------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // --------------------------------------------------------------------
    // 1. Colección de Perfiles de Usuario
    // --------------------------------------------------------------------
    match /users/{userId} {
      // Privacidad: El dueño lee su documento, El Docente/Interno lee todos los documentos para listados de staff.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isDocente() || isInterno());
      
      // Prevención de Elevación de Rol:
      // Se permite registrarse inicialmente como "PENDING" (Fase 9).
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId 
                    && (request.resource.data.role == "PENDING" || (request.auth.token.email != null && request.auth.token.email.matches("(?i).*(nicolas\\.ayelef|kinesiologo).*")));
                    
      // Los Docentes pueden actualizar cualquier campo. Los usuarios pueden actualizar su propio perfil excepto su rol.
      // Excepción Docente Admin: Permite auto-activación de las cuentas docentes del sistema.
      allow update: if isAuthenticated() && (
                      isDocente() || 
                      (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
                      (request.auth.uid == userId && request.auth.token.email != null && request.auth.token.email.matches("(?i).*(nicolas\\.ayelef|kinesiologo).*"))
                    );
      
      // Eliminación deshabilitada por seguridad histórica.
      allow delete: if false;
    }

    // --------------------------------------------------------------------
    // 2. Colecciones del Sistema (Silos en Espacios de Nombre por Año)
    // --------------------------------------------------------------------
    match /programs/{year} {
      
      // 2.A - Meta / Configuraciones (Selector de año, switchs globales)
      match /meta/settings {
        // Necesario que INTERNOS y DOCENTES lo lean, para que el React Global Context
        // 'YearContext.tsx' logre enterarse cuál año está "isActive: true".
        allow read: if isAuthenticated();
        
        // Solo un DOCENTE autorizado via su UID puede editar switches.
        allow write: if isDocente();
      }

      // 2.B - Contenido Clínico (Usuarias, Episodios, Sesiones, etc)
      match /{subcollection}/{document=**} {
        // Acceso omnipotente al DOCENTE (Consultar e interactuar con años pasados o cerrados)
        allow read, write: if isDocente();
        
        // El INTERNO solo puede leer y escribir SI ese programa ({year})
        // se encuentra marcado como 'isActive: true' en su archivo de configuración.
        // Si el DOCENTE apaga ese año, automáticamente el INTERNO pierde el acceso de lectura/escritura a sus carpetas.
        allow read, write: if isInterno() && isProgramActive(year);
      }
    }

    // --------------------------------------------------------------------
    // 3. Pasantía 2º Año – Formulario Público de Estudiantes
    // --------------------------------------------------------------------
    match /pasantia_entregas/{entregaId} {
      // Cualquier persona puede crear una entrega (sin login).
      allow create: if true;
      // Solo el DOCENTE puede leer todas las entregas y actualizar (guardar revisión).
      allow read, update: if isDocente();
      // Eliminación solo por DOCENTE
      allow delete: if isDocente();
    }

    // --------------------------------------------------------------------
    // 4. Simulador de Examen Clínico – Intentos
    // --------------------------------------------------------------------
    match /simulador_intentos/{intentoId} {
      // Cualquier usuario autenticado puede crear su propio intento.
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      // El estudiante lee solo sus propios intentos. El Docente lee todos.
      allow read: if isAuthenticated() 
                  && (resource.data.userId == request.auth.uid || isDocente());
      // Solo el Docente puede eliminar intentos.
      allow delete: if isDocente();
      // Los intentos son inmutables (no se pueden editar después de creados).
      allow update: if false;
    }

    // --------------------------------------------------------------------
    // 5. Configuración de Tareas del Simulador
    // --------------------------------------------------------------------
    match /settings/{docId} {
      // Todos pueden leer para saber si tienen tarea.
      allow read: if isAuthenticated();
      // Solo el docente puede asignar tareas.
      allow write: if isDocente();
    }

    // --------------------------------------------------------------------
    // 6. Defensa de Voz – Intentos (Defensa Comisión por Voz)
    // --------------------------------------------------------------------
    match /defensas_voz_intentos/{intentoId} {
      // Cualquier usuario autenticado puede crear su propio intento.
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      // El estudiante lee solo sus propios intentos. El Docente lee todos.
      allow read: if isAuthenticated() 
                  && (resource.data.userId == request.auth.uid || isDocente());
      // Solo el Docente puede eliminar intentos.
      allow delete: if isDocente();
      // Los intentos son inmutables (no se pueden editar después de creados).
      allow update: if false;
    }

    // --------------------------------------------------------------------
    // 7. Biblioteca de Evidencia Clínica (Journal Club)
    // Se conserva mientras el módulo siga existiendo en producción.
    // --------------------------------------------------------------------
    match /evidence_tasks/{taskId} {
      allow read: if isDocente() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isDocente() || (isAuthenticated() && request.resource.data.studentId == request.auth.uid);
      allow delete: if isDocente();
      allow update: if isDocente() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    match /evidence_articles/{articleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isDocente();
    }

    // --------------------------------------------------------------------
    // 8. Perfiles de Entrenamiento Diario (Tutoría Socrática)
    // --------------------------------------------------------------------
    match /training_profiles/{userId} {
      // El estudiante lee y escribe su propio perfil. El Docente lee todos.
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isDocente());

      // Historial inmutable de intentos: conserva transcripción, nota,
      // modalidad y reconexiones para revisión del estudiante y docente.
      match /sessions/{sessionId} {
        allow read, create: if isAuthenticated() && (request.auth.uid == userId || isDocente());
        allow update, delete: if isDocente();
      }
    }

    // --------------------------------------------------------------------
    // 9. Colecciones Privadas del Agente Docente Autónomo
    // --------------------------------------------------------------------
    match /teacher_agent_reviews/{reviewId} {
      allow read, write: if isDocente();
    }
    match /student_learning_profiles/{studentId} {
      allow read, write: if isDocente();
    }
    match /teacher_decisions/{decisionId} {
      allow read, write: if isDocente();
    }
    match /agent_runs/{runId} {
      allow read, write: if isDocente();
    }
    match /student_message_drafts/{draftId} {
      allow read, write: if isDocente();
    }
    match /patient_continuity_summaries/{patientId} {
      allow read, write: if isDocente();
    }
    match /teacher_notifications/{notificationId} {
      allow read, write: if isDocente();
    }
    match /proposed_simulations/{proposalId} {
      allow read, write: if isDocente();
    }
    // --------------------------------------------------------------------
    // 9.B Avisos y comentarios que SÍ ve la estudiante
    // --------------------------------------------------------------------

    // Tareas clínicas publicadas por el docente o por el censo.
    // No estaba declarada y la regla maestra es deny-by-default: el botón
    // "Avisar en su página" fallaba en silencio.
    match /student_clinical_tasks/{taskId} {
      allow read, write: if isDocente();
      // La estudiante solo ve las suyas.
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }

    // Comentarios anclados a una sección de la ficha.
    match /record_comments/{commentId} {
      // El docente comenta, lee y corrige todo.
      allow read, write: if isDocente();

      // La estudiante lee únicamente los comentarios dirigidos a ella.
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;

      // Y lo único que puede hacer es marcarlos como corregidos: no puede
      // editar el texto del docente, reasignarlo ni borrarlo.
      allow update: if isAuthenticated()
                    && resource.data.studentId == request.auth.uid
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.comment == resource.data.comment
                    && request.resource.data.status == "RESOLVED"
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(["status", "resolvedAt"]);

      allow delete: if isDocente();
    }

    match /intern_expedientes/{studentId} {
      // Solo lectura para el estudiante propietario si el estado es APROBADO_ENVIADO. Docente lee/escribe todo.
      allow read: if isDocente() || (isAuthenticated() && request.auth.uid == studentId && resource.data.status == "APROBADO_ENVIADO");
      allow write: if isDocente();
    }
  }
}
